[Unit]
Description=DriveSync - Monitoramento em tempo real (inotify) de ~/Nuvem
After=default.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/nuvem-sync/env
ExecStart=%h/Projetos/DriveSync/scripts/watcher.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
