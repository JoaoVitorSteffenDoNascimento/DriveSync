[Unit]
Description=DriveSync - Sincronização bidirecional Rclone (~/Nuvem <-> Google Drive)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.config/nuvem-sync/env
ExecStart=%h/Projetos/DriveSync/scripts/run-bisync.sh
Nice=10
IOSchedulingClass=idle
