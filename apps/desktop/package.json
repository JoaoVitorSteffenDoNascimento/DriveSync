{
  "name": "@drivesync/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Interface desktop simples do DriveSync para Windows 10/11 e Linux",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "pack:linux": "npm run build && electron-builder --config electron-builder.yml --linux",
    "pack:win": "npm run build && electron-builder --config electron-builder.yml --win"
  },
  "dependencies": {
    "@drivesync/shared": "*",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
